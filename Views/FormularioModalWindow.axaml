<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:New.ViewModels"
        xmlns:m="using:New.Models"
        xmlns:u="using:New.Utilities"
        x:Class="New.Views.FormularioModalWindow"
        x:DataType="vm:FormularioPersonalViewModel"
        Title="Formulario" Width="300" Height="400"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Spacing="10" Margin="20">
            <TextBlock Text="Dni:" />
            <TextBox Text="{Binding Dni}" />

            <TextBlock Text="Nombre:" />
            <TextBox Text="{Binding Nombre}" />

            <TextBlock Text="Email:" />
            <TextBox Text="{Binding Email}" />

            <!--Falta añadir el selector de asignaciones-->
            <Border>
                <ListBox ItemsSource="{Binding ReparacionesAsignadas}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="u:SeleccionReparacion">
                            <CheckBox Content="{Binding IdReparacion}" 
                                    IsChecked="{Binding Seleccionada}" 
                                    Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" CommandParameter="{Binding $parent[Window]}"/>
            <Button Content="Guardar" Command="{Binding GuardarCambiosCommand}" CommandParameter="{Binding $parent[Window]}"/>
        </StackPanel>
    </StackPanel>
</Window>